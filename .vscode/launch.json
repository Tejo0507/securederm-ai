{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Aggregator server",
      "type": "debugpy",
      "request": "launch",
      "module": "aggregator.server",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Web backend",
      "type": "debugpy",
      "request": "launch",
      "module": "web_backend.main",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
