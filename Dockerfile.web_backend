# ── Web Platform Backend ─────────────────────────────────────────────
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir torch torchvision --index-url ${TORCH_INDEX_URL}

COPY requirements-service.txt .
RUN pip install --no-cache-dir -r requirements-service.txt

COPY config/ config/
COPY model/ model/
COPY hospital_node/ hospital_node/
COPY web_backend/ web_backend/
COPY __init__.py .

# Persisted via volumes in docker-compose.yml: the sqlite database,
# uploaded dataset images, and model checkpoints all need to survive a
# container restart/rebuild.
RUN useradd --system --uid 10001 --no-create-home app \
    && mkdir -p data datasets/uploads checkpoints logs \
    && chown -R app:app /app
USER app

EXPOSE 8001

ENV HOST=0.0.0.0
ENV PORT=8001
ENV ENV=production

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import os,urllib.request as u; u.urlopen('http://127.0.0.1:%s/api/health' % os.getenv('PORT','8001'), timeout=3)"

CMD ["python", "-m", "web_backend.main"]
