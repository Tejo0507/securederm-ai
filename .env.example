# Copy this file to .env and fill in real values. Never commit .env
# itself — it's already covered by .gitignore's `.env*` pattern.

# ── Sessions (web_backend) ───────────────────────────────────────────────
# HMAC secret used to sign session tokens. If unset, the app generates a
# random one at process startup instead — safe (no forgeable hardcoded
# secret), but every restart invalidates all existing sessions. Set this
# to a stable value for a real deployment: `python -c "import secrets;
# print(secrets.token_hex(32))"`
JWT_SECRET=

# ── Database ──────────────────────────────────────────────────────────────
# Defaults to sqlite:///<repo>/securederm.db. Override to point at a
# different file (or another SQLAlchemy-supported database entirely).
DATABASE_URL=

# ── Email verification (web_backend) ────────────────────────────────────
# All optional. Without them, signup still works: the verification link
# is logged to the console and echoed back in the API response instead of
# actually being emailed — fine for local development, not for anything
# reachable by real users. To use a Gmail account: enable 2FA on it, then
# create an "App Password" (myaccount.google.com/apppasswords) and use
# that as SMTP_PASSWORD, not the account's real password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
# Base URL the verification link points back to (the Next.js frontend).
FRONTEND_URL=http://localhost:3000

# ── Deployment (web_backend) ─────────────────────────────────────────────
# "production" disables uvicorn autoreload, hides interactive API docs
# (/docs, /redoc, /openapi.json), and stops error responses from
# including internal details.
ENV=development
# 127.0.0.1 = only this machine. Set to 0.0.0.0 to accept connections
# from other devices on the network (e.g. running this laptop as a real
# server) — only do that behind your own firewall/router rules; this app
# has no TLS termination of its own, so put a reverse proxy in front of
# it (nginx/Caddy) for anything beyond your local network.
HOST=127.0.0.1
PORT=8001
# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies). Must exactly match the origin the browser sends,
# including scheme and port.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ── Federated learning (aggregator / hospital nodes) ─────────────────────
AGGREGATOR_HOST=127.0.0.1
AGGREGATOR_PORT=8000
